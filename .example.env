# Copy to .env and adjust the values for your environment:
#   cp .example.env .env
#
# See docs/src/developer/install.md for a full local setup walkthrough.
# Every value below is a placeholder. Do not commit a filled-in .env (it is
# gitignored) and do not reuse these placeholders in a deployed environment.

# ---------------------------------------------------------------------------
# PostGIS
# ---------------------------------------------------------------------------
# POSTGIS_DB is the database the db container creates on first boot.
# POSTGRES_DB is what Django connects to (passed through as DJANGO_DB).
# Keep the two identical unless you know why you are separating them.
POSTGIS_DB=minisass
POSTGRES_DB=minisass
POSTGRES_USER=docker
POSTGRES_PASS=docker
ALLOW_IP_RANGE=0.0.0.0/0
POSTGRES_MULTIPLE_EXTENSIONS=postgis,hstore,postgis_topology,postgis_raster,pgrouting
FORCE_SSL=FALSE

# WARNING: deployment/docker/entrypoint.sh runs "DROP VIEW", applies SQL DDL and
# runs "manage.py migrate" against DATABASE_HOST on EVERY container start. Never
# point a development stack at a shared or production database server.
DATABASE_HOST=db
DATABASE_PORT=5432

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
SERVER_MODE=production

# DEBUG must be False for a self-contained stack: it also selects how the React
# SPA is loaded. With DEBUG=True the page loads the Vite dev server on port 5173
# instead of the built bundle, so you get a blank page unless you also run
# "make frontend-dev".
DEBUG=False

# Generate a unique value per deployment, e.g.
#   python -c 'import secrets; print(secrets.token_urlsafe(50))'
# Leaving this unset falls back to a value committed in
# minisass/settings/default.py, which is public and must not be used in
# production. Note that django-fernet encrypted fields (the constance settings)
# are keyed off SECRET_KEY, so changing it on an existing database makes those
# stored values unreadable and they will need to be re-entered.
SECRET_KEY=

MEDIA_ROOT=/home/web/media
MEDIA_URL=/media/
STATIC_ROOT=/home/web/static
STATIC_URL=/static/

# DEV_SETUP=TRUE re-runs "npm install && npm run build" on every container start.
# It is needed on first boot because docker-compose.yml bind-mounts
# ./django_project over the image's build output. Set it back to FALSE once
# django_project/minisass_frontend/src/dist exists.
DEV_SETUP=TRUE

# ---------------------------------------------------------------------------
# nginx / TLS
# ---------------------------------------------------------------------------
# Leave HTTP_HOST empty if you want HTTPS only.
HTTP_HOST=localhost
HTTP_PORT=80
HTTPS_HOST=${COMPUTER_HOSTNAME}
HTTPS_PORT=443
# Set to 'production' only when deploying on your own domain with real
# certificates. Use 'disabled' locally.
LETSENCRYPT_MODE=disabled
ADMIN_EMAIL=
RESOLVER=127.0.0.11

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
# Two related but distinct values:
#   MINIO_BUCKET     path prefix stored in database file fields
#                    (e.g. minisass/observations/...). Changing it invalidates
#                    the URLs already recorded in the database.
#   MINIO_AI_BUCKET  the actual bucket name used for boto3 calls.
#
# For local MinIO leave MINIO_URL pointing at the minio service. To use real
# AWS S3 instead, set MINIO_URL to https://s3.<region>.amazonaws.com and supply
# IAM credentials below.
BUCKET=demo
MINIO_BUCKET=demo
MINIO_AI_BUCKET=demo
MINIO_URL=http://minio:9000
MINIO_ENDPOINT=http://minio:9000
AWS_S3_REGION_NAME=af-south-1
SECURE_CONNECTION=False

# Credentials for the local MinIO service (docker-compose 'minio').
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Credentials used by Django/boto3 to read and write objects.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_SECRET_ACCESS_KEY=

# Used by the nginx image to proxy /minio-media/ and /static/ to a public S3
# bucket. Only relevant when serving media straight from S3.
S3_MEDIA_BUCKET=
S3_MEDIA_REGION=af-south-1

# ---------------------------------------------------------------------------
# Vector tiles (pg_tileserv)
# ---------------------------------------------------------------------------
# Public base URL that tile links should advertise.
VECTOR_TILES_URL=http://localhost:61122/tiles

# ---------------------------------------------------------------------------
# Country lookup / ocean validation
# ---------------------------------------------------------------------------
# New sites are intersected against a world-boundaries WFS layer to derive the
# country code and to reject coordinates in the ocean. Override these to point at
# an IWMI-hosted layer; see minisass/settings/default.py for the defaults.
COUNTRY_LOOKUP_WFS_URL=
COUNTRY_LOOKUP_WFS_TYPENAME=
COUNTRY_LOOKUP_WFS_GEOMETRY=

# ---------------------------------------------------------------------------
# Initial superuser
# ---------------------------------------------------------------------------
# Created on first start only if all three are set. Choose your own values;
# creation is skipped rather than falling back to any default.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Production sends through the Amazon SES API, not SMTP.
#
# SES publishes no SMTP endpoint in af-south-1: email-smtp.af-south-1.amazonaws.com
# has no DNS record at all, so the SMTP backend could never connect and every send
# failed with "No address associated with hostname". Delivery therefore goes over
# the SES API, which is available in this region.
#
# Production needs no SMTP values. It authenticates with the ECS task role, so
# there is no SMTP password to store, and the only requirement is that the role
# is allowed ses:SendEmail on the sending identity.
#
# Locally, print mail to the container log instead of trying to reach AWS:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
#
# Optional overrides:
#   SES_FALLBACK_FROM_EMAIL   a verified identity to send from when SES refuses
#                             the primary one. An SES domain has to verify before
#                             it can send and that is asynchronous, so a newly
#                             added domain leaves a window where no mail goes out
#                             at all. Production sets this to
#                             'miniSASS <no-reply@digitaltwins.iwmi.org>'.
#                             The primary address is always tried first, so this
#                             stops applying by itself once the domain verifies.
#   AWS_SES_REGION_NAME       defaults to AWS_S3_REGION_NAME, then af-south-1
#   AWS_SES_CONFIGURATION_SET enables SES bounce/complaint event publishing
#   AWS_SES_ACCESS_KEY_ID / AWS_SES_SECRET_ACCESS_KEY
#                             only if the task role cannot be used
#
# The SMTP_* values below are still read by settings, so switching back to SMTP
# remains possible if sending ever moves to a region that offers an endpoint.
# They are unused as things stand.
# Where contact-form and support submissions are delivered. Comma-separated.
#
# These have no default. minisass.org publishes no MX record, so info@ and
# support@minisass.org cannot receive anything - they are send-only identities.
# Leaving these unset used to drop submissions silently; now the send is refused
# and logged. Production sets them via Secrets Manager.
CONTACT_US_RECIPIENT_EMAILS=
SUPPORT_RECIPIENT_EMAILS=
# Recipient of unhandled-exception mail when DEBUG is False. Leave blank unless
# it is a mailbox that actually exists: undeliverable error mail bounces, and
# bounces count against the SES sending reputation.
SMTP_EMAIL=
SMTP_EMAIL_TLS=
SMTP_HOST=
SMTP_HOST_PASSWORD=
SMTP_HOST_USER=
SMTP_PORT=
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Third-party keys and misc
# ---------------------------------------------------------------------------
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=
SENTRY_KEY=
GOOGLE_ANALYTICS_TRACKING_CODE=

# Memory ceiling for the TensorFlow image classifier.
TF_MEMORY_LIMIT_GB=0.5

# Comma-separated IPs allowed to reach endpoints guarded by
# IsAuthenticatedOrWhitelisted (used by the mobile app backend).
WHITELISTED_IP_ADDRESSES=""
